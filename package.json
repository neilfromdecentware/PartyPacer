{
  "name": "party-pacer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:icons": "node scripts/build-icons.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy": "npm run build && firebase deploy --only hosting:party-pacer",
    "deploy:preview": "npm run build && firebase deploy --only hosting:partypacer-preview",
    "deploy:feedback": "firebase deploy --only hosting:partypacer-feedback",
    "deploy:rules": "firebase deploy --only firestore:rules"
  },
  "dependencies": {
    "qrcode.react": "^4.2.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "firebase-tools": "^14.0.0",
    "sharp": "^0.34.5",
    "typescript": "^5.7.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.4"
  }
}
